---
import Base from '../../layouts/Base.astro';
import CardLink from '../../components/CardLink.astro';
import PageTitle from '../../components/PageTitle.astro';
import Prose from '../../components/Prose.astro';
---

<Base title="Tools" description="Small browser utilities by Nicolò Rebughini">
  <article class="post font-mono">
    <PageTitle title="Tools" />

    <Prose>
      <p>Small utilities that run entirely in your browser. No accounts, no uploads — your files never leave your device.</p>
    </Prose>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12 mt-6">
      <CardLink
        href="/tools/out-of-black/"
        index={1}
        title="I'm out of black"
        description="Convert PDFs & images to a dark ink color when the black cartridge runs dry."
      />
    </div>
  </article>
</Base>
