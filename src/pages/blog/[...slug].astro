---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => data.published !== false)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Base title={post.data.title} description={post.data.description}>
  <article itemscope itemtype="http://schema.org/BlogPosting" class="font-mono">
    <header class="mb-8">
      <h1
        class="font-mono leading-tight text-3xl font-bold text-black mb-4 mt-8 border-b-2 border-indigo-600 pb-2"
        itemprop="name headline"
      >
        {post.data.title}
      </h1>
      {post.data.description && (
        <blockquote class="border-l-4 border-indigo-600 bg-gray-50 p-4 my-6 font-mono text-black">
          <span class="text-indigo-600 font-bold">&gt; </span>{post.data.description}
        </blockquote>
      )}
      <p class="text-sm text-black font-mono">
        <span class="text-indigo-600 font-bold">$</span> published_on{' '}
        <time class="font-bold" datetime={post.data.date.toISOString()} itemprop="datePublished">
          {formatDate(post.data.date)}
        </time>{' '}
        --author{' '}
        <span itemprop="author" itemscope itemtype="http://schema.org/Person">
          <span class="font-bold" itemprop="name">nicolo</span>
        </span>
      </p>
    </header>

    <div class="mt-8 markdown" itemprop="articleBody">
      <Content />
    </div>
  </article>
</Base>
