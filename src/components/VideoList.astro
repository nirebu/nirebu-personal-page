---
import type { Video } from '../data/site';

interface Props {
  videos: Video[];
  currentPage: number;
  totalPages: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { videos, currentPage, totalPages, prevUrl, nextUrl } = Astro.props as Props;
---

<article class="post font-mono">
  <header class="post-header mb-8">
    <h1 class="font-mono leading-tight text-3xl font-bold text-black mb-4 mt-8 border-b-2 border-indigo-600 pb-2">
      Videos
    </h1>
  </header>

  <div class="markdown">
    <p>Here is a collection of my YouTube videos (in Italian 🇮🇹). I talk about Digital Awareness, Ruby Programming, and sometimes Artificial Intelligence.</p>
  </div>

  <div class="bg-gray-800 text-white p-6 border-2 border-gray-800 mb-8 mt-6">
    <div class="text-sm text-purple-400 mb-2 font-bold">FEATURED</div>
    <h3 class="text-xl font-bold mb-2">🎓 Ruby Course</h3>
    <div class="text-gray-300 text-sm">
      Interested in learning Ruby? Check out my complete
      <a href="https://www.youtube.com/playlist?list=PLrwPD9g3LY7IDGPJPVcNarrIGPbh0IelA" target="_blank" class="underline font-semibold text-white hover:text-purple-400">Ruby Course Playlist</a>.
    </div>
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-1 mb-12">
    {videos.map((video) => (
      <div class="bg-gray-800 text-white p-6 border-2 border-gray-800 hover:border-purple-600 transition-all">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-purple-400 font-bold">{video.category}</span>
          <span class="text-xs text-gray-400">Ep. {video.episode}</span>
        </div>
        <h3 class="text-xl font-bold mb-2">
          {video.youtube_id ? (
            <a href={`https://www.youtube.com/watch?v=${video.youtube_id}`} target="_blank" class="text-white hover:text-purple-400 transition-colors">
              {video.title}
            </a>
          ) : (
            video.title
          )}
        </h3>
        <p class="text-gray-300 text-sm mb-4">{video.description}</p>
        {video.youtube_id ? (
          <div class="relative h-0 overflow-hidden bg-gray-800 border-2 border-gray-700" style="padding-bottom: 56.25%;">
            <iframe
              class="absolute top-0 left-0 w-full h-full border-0"
              src={`https://www.youtube.com/embed/${video.youtube_id}`}
              title={video.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        ) : (
          <div class="text-sm text-gray-400 italic">
            (Video ID not set. <a href="https://www.youtube.com/@nirebu" class="text-purple-400 hover:underline">Visit Channel</a>)
          </div>
        )}
      </div>
    ))}
  </div>

  {totalPages > 1 && (
    <div class="flex justify-between items-center mt-8 mb-12">
      {prevUrl ? (
        <a href={prevUrl} class="btn-primary">&larr; Newer Videos</a>
      ) : (
        <span />
      )}
      <span class="text-gray-600 text-sm uppercase tracking-wider font-bold">
        Page {currentPage} of {totalPages}
      </span>
      {nextUrl ? (
        <a href={nextUrl} class="btn-primary">Older Videos &rarr;</a>
      ) : (
        <span />
      )}
    </div>
  )}
</article>
